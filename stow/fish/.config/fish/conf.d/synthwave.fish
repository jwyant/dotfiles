# SynthWave '84 color palette as fish variables (ANSI names)
# Palette hex values are defined once in the terminal emulator config
set -g color_black     black        # 0  #262335 background
set -g color_red       red          # 1  #fe4450
set -g color_green     green        # 2  #72f1b8
set -g color_yellow    yellow       # 3  #f3e70f
set -g color_blue      blue         # 4  #03edf9
set -g color_magenta   magenta      # 5  #ff7edb
set -g color_cyan      cyan         # 6  #03edf9
set -g color_white     white        # 7  #ffffff
set -g color_brblack   brblack      # 8  #848bbd comments
set -g color_brred     brred        # 9  #fe4450
set -g color_brgreen   brgreen      # 10 #72f1b8
set -g color_bryellow  bryellow     # 11 #fede5d keywords
set -g color_brblue    brblue       # 12 #03edf9
set -g color_brmagenta brmagenta    # 13 #ff7edb
set -g color_brcyan    brcyan       # 14 #03edf9
set -g color_brwhite   brwhite      # 15 #ffffff
