[user]
    name  = Your Name
    email = you@example.com

[core]
    pager     = delta
    autocrlf  = input

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[delta]
    navigate    = true
    light       = false
    line-numbers = true
    side-by-side = true
    syntax-theme = ansi

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
